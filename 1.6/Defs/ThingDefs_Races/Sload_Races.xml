            </li>
            <li Class="ESCP_RaceTools.RaceProperties">
                <eventOnDeath>ESCP_KilledSload</eventOnDeath>
                <thrassianPlagueImmune>true</thrassianPlagueImmune>
            </li>
        </modExtensions>
