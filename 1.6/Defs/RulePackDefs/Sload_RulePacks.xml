<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <RulePackDef>
        <defName>ESCP_Namer_Sload</defName>
        <rulePack>
            <rulesStrings>
                <li>r_name->[sloadName] [sloadName]</li>
                <li>sloadName->[letter][a][b]</li>
            </rulesStrings>
            <rulesFiles>
                <li>letter->ESCP_SloadNames/ESCP_SloadLetters</li>
                <li>a->ESCP_SloadNames/ESCP_SloadNamesA</li>
                <li>b->ESCP_SloadNames/ESCP_SloadNamesB</li>
            </rulesFiles>
        </rulePack>
    </RulePackDef>

    <RulePackDef>
        <defName>ESCP_Namer_SloadSettlement</defName>
        <include>
            <li>TribalWordUtility</li>
        </include>
        <rulePack>
            <rulesStrings>
                <li>r_name->The [Color] [b]</li>
                <li>r_name->The [a] [b]</li>
                <li>r_name->[letter][nameA][nameB]'s [b]</li>
            </rulesStrings>
            <rulesFiles>
                <li>a->ESCP_SloadNames/ESCP_SloadFactionA</li>
                <li>b->ESCP_SloadNames/ESCP_SloadFactionB</li>
                <li>letter->ESCP_SloadNames/ESCP_SloadLetters</li>
                <li>nameA->ESCP_SloadNames/ESCP_SloadNamesA</li>
                <li>nameB->ESCP_SloadNames/ESCP_SloadNamesB</li>
            </rulesFiles>
        </rulePack>
    </RulePackDef>

    <RulePackDef>
        <defName>ESCP_Namer_SloadFaction</defName>
        <rulePack>
            <rulesStrings>
                <li>r_name->Sload Kingdom of [letter][a][b]</li>
            </rulesStrings>
            <rulesFiles>
                <li>letter->ESCP_SloadNames/ESCP_SloadLetters</li>
                <li>a->ESCP_SloadNames/ESCP_SloadNamesA</li>
                <li>b->ESCP_SloadNames/ESCP_SloadNamesB</li>
            </rulesFiles>
        </rulePack>
    </RulePackDef>

    <RulePackDef>
        <defName>ESCP_Namer_SloadLeaderTitle</defName>
        <include>
            <li>LeaderTitleMaker_GlobalStructure</li>
        </include>
        <rulePack>
            <rulesStrings>
                <li>memeLeaderNoun(priority=1)->[cultureLeaderNoun]</li>
                <li>cultureLeaderTitle->[cultureLeaderAdjective] [cultureLeaderNoun]</li>
                <li>cultureLeaderAdjective->[a]</li>
                <li>cultureLeaderNoun->king</li>
            </rulesStrings>
            <rulesFiles>
                <li>a->ESCP_SloadNames/ESCP_SloadFactionA</li>
            </rulesFiles>
        </rulePack>
    </RulePackDef>

    <RulePackDef>
        <defName>ESCP_Namer_SloadDeity</defName>
        <include>
            <li>NamerDeityGlobal</li>
        </include>
        <rulePack>
            <rulesStrings>
                <li>name->[deity]</li>
            </rulesStrings>
            <rulesFiles>
                <li>deity->ESCP_SloadNames/ESCP_SloadDeities</li>
            </rulesFiles>
        </rulePack>
    </RulePackDef>

</Defs>
