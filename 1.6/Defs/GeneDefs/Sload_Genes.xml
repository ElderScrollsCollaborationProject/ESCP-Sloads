<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <GeneDef>
        <defName>ESCP_Gene_Sload_Body</defName>
        <canGenerateInGeneSet>false</canGenerateInGeneSet>
        <label>Sload body</label>
        <description>Carriers are huge, boneless slugs with a broad head and a thick, trailing tail. They grow no hair.</description>
        <iconPath>UI/Icons/Genes/Gene_HairStyleBaldOnly</iconPath>
        <displayCategory>Cosmetic</displayCategory>
        <biostatCpx>0</biostatCpx>
        <tattoosVisible>false</tattoosVisible>
        <exclusionTags>
            <li>Head</li>
            <li>HairStyle</li>
            <li>Tail</li>
        </exclusionTags>
        <forcedHeadTypes>
            <li>ESCP_Head_Sload</li>
        </forcedHeadTypes>
        <hairTagFilter>
            <whitelist>true</whitelist>
            <tags>
                <li>Bald</li>
            </tags>
        </hairTagFilter>
        <beardTagFilter>
            <whitelist>true</whitelist>
            <tags>
                <li>NoBeard</li>
            </tags>
        </beardTagFilter>
        <renderNodeProperties>
            <li>
                <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
                <texPath>Things/Pawn/Humanlike/ESCP_Sload/Tail/SloadTail</texPath>
                <colorType>Skin</colorType>
                <parentTagDef>Body</parentTagDef>
                <rotDrawMode>Fresh, Rotting</rotDrawMode>
                <drawData>
                    <defaultData>
                        <layer>-2</layer>
                    </defaultData>
                    <dataNorth>
                        <offset>(0, 0, -0.75)</offset>
                        <layer>-2</layer>
                    </dataNorth>
                    <dataEast>
                        <offset>(-0.9, 0, -0.45)</offset>
                        <layer>-2</layer>
                    </dataEast>
                </drawData>
            </li>
        </renderNodeProperties>
    </GeneDef>

    <GeneDef>
        <defName>ESCP_Gene_Sload_Necromancy</defName>
        <canGenerateInGeneSet>false</canGenerateInGeneSet>
        <label>Sload necromancy</label>
        <description>Carriers can bind fresh corpses as thralls. Thralls feel nothing and need nothing, but the binding breaks if their master goes down. The more intellectual the Sload, the more thralls it can hold.</description>
        <geneClass>ESCP_NecromanticThralls.Gene_Necromancer</geneClass>
        <iconPath>UI/Abilities/ESCP_SloadCreateThrall</iconPath>
        <displayCategory>Ability</displayCategory>
        <biostatCpx>3</biostatCpx>
        <biostatMet>-2</biostatMet>
    </GeneDef>

    <GeneDef>
        <defName>ESCP_Gene_Sload_Emotionless</defName>
        <canGenerateInGeneSet>false</canGenerateInGeneSet>
        <label>emotionless</label>
        <description>Carriers feel almost nothing. Only hunger, pain, exhaustion and a few other plain needs reach them, and their mood stays high no matter what goes on around them.</description>
        <iconPath>UI/Icons/Genes/Gene_DeadCalm</iconPath>
        <displayCategory>Mood</displayCategory>
        <biostatCpx>2</biostatCpx>
        <biostatMet>-3</biostatMet>
    </GeneDef>

    <GeneDef>
        <defName>ESCP_Gene_Sload_DiseaseImmunity</defName>
        <canGenerateInGeneSet>false</canGenerateInGeneSet>
        <label>Sload disease immunity</label>
        <description>Carriers cannot catch the flu, the plague, malaria, sleeping sickness or the Thrassian Plague their own kind made.</description>
        <iconPath>UI/Icons/Genes/Gene_PerfectImmunity</iconPath>
        <displayCategory>Healing</displayCategory>
        <biostatCpx>2</biostatCpx>
        <biostatMet>-2</biostatMet>
        <makeImmuneTo>
            <li>Flu</li>
            <li>Plague</li>
            <li>Malaria</li>
            <li>SleepingSickness</li>
            <li>ESCP_Hediff_ThrassianPlague</li>
        </makeImmuneTo>
    </GeneDef>

