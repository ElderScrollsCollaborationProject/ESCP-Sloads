            <Intellectual>500</Intellectual>
            <Medicine>250</Medicine>
        </trainingXpPerHour>
        <expedition>ESCP_Expedition_Faction_Novice</expedition>
        <discipline>Scholarly</discipline>
        <nextTierOptions>
            <li>ESCP_Rank_SloadKingdom_SoulBinder</li>
        </nextTierOptions>
    </ESCP.Ranks.RankTierDef>

    <ESCP.Ranks.RankTierDef>
        <defName>ESCP_Rank_SloadKingdom_SoulBinder</defName>
        <label>soul-binder</label>
