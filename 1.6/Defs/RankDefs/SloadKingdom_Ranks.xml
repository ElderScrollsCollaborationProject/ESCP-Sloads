<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ESCP.Ranks.RankTrackDef>
        <defName>ESCP_RankTrack_SloadKingdom</defName>
        <label>Thras ranks</label>
        <rootTier>ESCP_Rank_SloadKingdom_Servant</rootTier>
        <owningFaction>ESCP_Faction_Sload</owningFaction>
        <collectiveNoun>Thras</collectiveNoun>
        <drillLabel>Corpse Drill</drillLabel>
        <drillDesc>Train with any colonist. Both stop what they are doing and both gain skill XP. Once per day.</drillDesc>
        <studyLabel>Study the Coral Tomes</studyLabel>
        <studyDesc>Study with another member. Both gain skill XP. Once per day.</studyDesc>
        <inspectLabel>Inspect Their Vestments</inspectLabel>
        <inspectDesc>Look over a junior member's gear. Good upkeep earns praise and poor upkeep earns a sharp word.</inspectDesc>
        <punishLabel>Send to the Brine Pits...</punishLabel>
        <punishDesc>Set a junior member to tedious labor for a failure, souring their mood. Once per day per member.</punishDesc>
        <rallyLabel>For Thras!</rallyLabel>
        <rallyDesc>Call on {0} to fight harder for a short while. Once every few days.</rallyDesc>
        <fallInLabel>Attend the Master</fallInLabel>
        <fallInDesc>Order {0} to gather behind you, up to four deep. They hold position until released.</fallInDesc>
        <dismissLabel>Return to the Depths</dismissLabel>
        <dismissDesc>Release {0} so they can return to their duties.</dismissDesc>
    </ESCP.Ranks.RankTrackDef>

    <ESCP.Ranks.RankTierDef>
        <defName>ESCP_Rank_SloadKingdom_Servant</defName>
        <label>servant</label>
        <description>Fetches and carries for a Sload, who barely notices.</description>
        <nextTierOptions>
            <li>ESCP_Rank_SloadKingdom_Acolyte</li>
        </nextTierOptions>
    </ESCP.Ranks.RankTierDef>

    <ESCP.Ranks.RankTierDef>
        <defName>ESCP_Rank_SloadKingdom_Acolyte</defName>
        <label>acolyte</label>
        <description>Learns the first secrets of Sload necromancy.</description>
        <minDaysInRank>4</minDaysInRank>
        <skillRequirements>
            <Intellectual>5</Intellectual>
        </skillRequirements>
        <minMissionsCompleted>1</minMissionsCompleted>
        <trainingXpPerHour>
            <Intellectual>400</Intellectual>
            <Medicine>200</Medicine>
        </trainingXpPerHour>
        <expedition>ESCP_Expedition_Faction_Novice</expedition>
        <discipline>Scholarly</discipline>
        <nextTierOptions>
            <li>ESCP_Rank_SloadKingdom_Necromancer</li>
        </nextTierOptions>
    </ESCP.Ranks.RankTierDef>

    <ESCP.Ranks.RankTierDef>
        <defName>ESCP_Rank_SloadKingdom_Necromancer</defName>
        <label>necromancer</label>
        <description>Raises and binds the dead for Thras.</description>
        <minDaysInRank>9</minDaysInRank>
        <skillRequirements>
            <Intellectual>8</Intellectual>
        </skillRequirements>
        <minMissionsCompleted>2</minMissionsCompleted>
