    <ThingDef ParentName="ApparelNoQualityBase">
        <defName>ESCP_Apparel_SloadBarrierBelt</defName>
        <label>Sload barrier belt</label>
        <description>An enchanted belt cut to fit the bulk of a Sload. It raises a barrier that tries to stop every incoming blow and missile, then needs a long while to recover once it breaks. Unlike a shield belt, it does not stop the wearer from casting or shooting out.</description>
        <thingClass>Apparel</thingClass>
        <techLevel>Medieval</techLevel>
        <graphicData>
            <texPath>Things/Pawn/Humanlike/Apparel/ESCP_SloadBarrierBelt</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <tickerType>Normal</tickerType>
        <smeltable>false</smeltable>
        <statBases>
            <Mass>2</Mass>
            <MarketValue>1000</MarketValue>
            <Flammability>0.4</Flammability>
            <EnergyShieldRechargeRate>0.01</EnergyShieldRechargeRate>
            <EnergyShieldEnergyMax>1.0</EnergyShieldEnergyMax>
            <EquipDelay>2</EquipDelay>
        </statBases>
        <thingCategories>
            <li>ApparelUtility</li>
        </thingCategories>
        <apparel>
            <countsAsClothingForNudity>false</countsAsClothingForNudity>
            <careIfWornByCorpse>false</careIfWornByCorpse>
            <careIfDamaged>false</careIfDamaged>
            <wearPerDay>0</wearPerDay>
            <bodyPartGroups>
                <li>Waist</li>
            </bodyPartGroups>
            <layers>
                <li>Belt</li>
            </layers>
            <tags>
                <li>ESCP_SloadBelt</li>
            </tags>
        </apparel>
        <comps>
            <li Class="CompProperties_Shield">
                <blocksRangedWeapons>false</blocksRangedWeapons>
                <minDrawSize>2</minDrawSize>
                <maxDrawSize>3</maxDrawSize>
            </li>
        </comps>
        <tradeTags>
            <li>ESCP_SloadElixir</li>
        </tradeTags>
        <modExtensions>
            <li Class="ESCP.Core.XenotypeExtension">
                <whitelistedXenotypes>
                    <li>ESCP_Xenotype_Sload</li>
                </whitelistedXenotypes>
            </li>
        </modExtensions>
    </ThingDef>

</Defs>
