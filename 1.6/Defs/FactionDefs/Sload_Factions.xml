<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <FactionDef ParentName="FactionBase">
        <defName>ESCP_Faction_Sload</defName>
        <label>Sload kingdom</label>
        <description>A chain of Sload outposts under the rule of a Sload king. Few peoples welcome the Sload, and the Sload return the favor.\n\nThis kingdom keeps to a fairly quiet life where it can, and will trade and even ally with strange peoples. It does not send raiders against its enemies. It sends the Thrassian Plague instead.</description>
        <colorSpectrum>
            <li>(0.0, 0.9, 0.7)</li>
            <li>(0.2, 0.9, 0.5)</li>
            <li>(0.7, 0.2, 1.0)</li>
        </colorSpectrum>
        <pawnSingular>Sload</pawnSingular>
        <pawnsPlural>Sloads</pawnsPlural>
        <categoryTag>Outlander</categoryTag>
        <techLevel>Medieval</techLevel>
        <basicMemberKind>ESCP_Pawnkind_Sload_Subject</basicMemberKind>
        <leaderTitle>king</leaderTitle>
        <factionIconPath>World/WorldObjects/Expanding/ESCP_SloadSettlement</factionIconPath>
        <factionNameMaker>ESCP_Namer_SloadFaction</factionNameMaker>
        <settlementNameMaker>ESCP_Namer_SloadSettlement</settlementNameMaker>
        <settlementTexturePath>World/WorldObjects/TribalSettlement</settlementTexturePath>
        <settlementGenerationWeight>0.5</settlementGenerationWeight>
        <requiredCountAtGameStart>1</requiredCountAtGameStart>
        <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
        <configurationListOrderPriority>40</configurationListOrderPriority>
        <canSiege>false</canSiege>
        <canStageAttacks>false</canStageAttacks>
        <backstoryFilters>
            <li>
                <categories>
                    <li>Tribal</li>
                </categories>
            </li>
        </backstoryFilters>
        <allowedCultures>
            <li>ESCP_Culture_Sload</li>
        </allowedCultures>
        <requiredMemes>
            <li MayRequire="Ludeon.RimWorld.Ideology">ESCP_Meme_SloadicWays</li>
        </requiredMemes>
        <disallowedMemes>
            <li MayRequire="Ludeon.RimWorld.Ideology">Supremacist</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">PainIsVirtue</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">Nudism</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">Raider</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">Blindsight</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">Cannibal</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">MaleSupremacy</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">FemaleSupremacy</li>
        </disallowedMemes>
        <structureMemeWeights>
            <Structure_Ideological MayRequire="Ludeon.RimWorld.Ideology">999</Structure_Ideological>
        </structureMemeWeights>
        <caravanTraderKinds>
            <li>ESCP_Caravan_Sload_Trader</li>
            <li>ESCP_Caravan_Sload_DrugTrader</li>
        </caravanTraderKinds>
        <visitorTraderKinds>
            <li>ESCP_Caravan_Sload_Trader</li>
        </visitorTraderKinds>
        <baseTraderKinds>
            <li>ESCP_Caravan_Sload_Trader</li>
        </baseTraderKinds>
        <raidLootMaker>ESCP_Sload_RaidLootMaker</raidLootMaker>
        <allowedArrivalTemperatureRange>0~50</allowedArrivalTemperatureRange>
        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(0, 35)</li>
                <li>(70, 50)</li>
                <li>(700, 100)</li>
                <li>(1300, 150)</li>
                <li>(100000, 10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>
        <pawnGroupMakers>
            <li>
                <kindDef>Combat</kindDef>
                <commonality>100</commonality>
                <options>
                    <ESCP_Pawnkind_Sload_PlagueBearer>5</ESCP_Pawnkind_Sload_PlagueBearer>
                    <ESCP_Pawnkind_Sload_Subject>3</ESCP_Pawnkind_Sload_Subject>
                    <ESCP_Pawnkind_Sload_Lord>1.5</ESCP_Pawnkind_Sload_Lord>
                    <Tribal_Warrior>10</Tribal_Warrior>
                    <Tribal_Archer>10</Tribal_Archer>
                </options>
            </li>
            <li>
                <kindDef>Peaceful</kindDef>
                <options>
                    <ESCP_Pawnkind_Sload_Subject>8</ESCP_Pawnkind_Sload_Subject>
                    <ESCP_Pawnkind_Sload_Lord>1.5</ESCP_Pawnkind_Sload_Lord>
                    <Tribal_Warrior>5</Tribal_Warrior>
                    <Tribal_Archer>5</Tribal_Archer>
                </options>
            </li>
            <li>
                <kindDef>Trader</kindDef>
                <traders>
                    <ESCP_Pawnkind_Sload_Trader>1</ESCP_Pawnkind_Sload_Trader>
                </traders>
                <carriers>
                    <Muffalo>6</Muffalo>
                    <Dromedary>5</Dromedary>
                    <Alpaca>2.5</Alpaca>
                    <Elephant>2</Elephant>
                </carriers>
                <guards>
                    <ESCP_Pawnkind_Sload_PlagueBearer>3</ESCP_Pawnkind_Sload_PlagueBearer>
                    <Tribal_Warrior>7</Tribal_Warrior>
                    <Tribal_Archer>10</Tribal_Archer>
                </guards>
            </li>
            <li>
                <kindDef>Settlement</kindDef>
                <options>
                    <ESCP_Pawnkind_Sload_Subject>6</ESCP_Pawnkind_Sload_Subject>
                    <ESCP_Pawnkind_Sload_PlagueBearer>7</ESCP_Pawnkind_Sload_PlagueBearer>
                    <ESCP_Pawnkind_Sload_Lord>4</ESCP_Pawnkind_Sload_Lord>
                    <Tribal_Warrior>7</Tribal_Warrior>
                    <Tribal_Archer>10</Tribal_Archer>
                </options>
            </li>
        </pawnGroupMakers>
    </FactionDef>

    <FactionDef ParentName="PlayerFactionBase">
        <defName>ESCP_Faction_Sload_Player</defName>
        <label>Sload exiles</label>
        <description>A few Sloads who have been driven out of their caves and now have to make a home somewhere else.</description>
        <isPlayer>true</isPlayer>
        <techLevel>Medieval</techLevel>
        <basicMemberKind>ESCP_Pawnkind_Sload_Colonist</basicMemberKind>
        <pawnSingular>Sload</pawnSingular>
        <pawnsPlural>Sloads</pawnsPlural>
        <leaderTitle>king</leaderTitle>
        <factionIconPath>World/WorldObjects/Expanding/ESCP_SloadSettlement</factionIconPath>
        <factionNameMaker>ESCP_Namer_SloadFaction</factionNameMaker>
        <settlementNameMaker>ESCP_Namer_SloadSettlement</settlementNameMaker>
        <colorSpectrum>
            <li>(0.45, 0.25, 0.6)</li>
        </colorSpectrum>
        <allowedCultures>
            <li>ESCP_Culture_Sload</li>
        </allowedCultures>
        <backstoryFilters>
            <li>
                <categories>
                    <li>ESCP_Backstory_Sload_Child</li>
                    <li>ESCP_Backstory_Sload_Adult</li>
                </categories>
            </li>
        </backstoryFilters>
    </FactionDef>

</Defs>
